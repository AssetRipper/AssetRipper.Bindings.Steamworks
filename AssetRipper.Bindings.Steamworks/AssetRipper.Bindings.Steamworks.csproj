<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <PackageId>AssetRipper.Bindings.Steamworks</PackageId>
    <PackageTags>Steamworks;Bindings;Native</PackageTags>
    <RepositoryUrl>https://github.com/AssetRipper/AssetRipper.Bindings.Steamworks</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/AssetRipper/AssetRipper.Bindings.Steamworks</PackageProjectUrl>
    <Copyright>Copyright (c) 2026 ds5678</Copyright>
    <Description>Cross-platform low-level bindings for the Steamworks API.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <PropertyGroup>
    <!-- CS0169: Private fields in native interop layouts may be intentionally unused. -->
    <!-- CS1591: Generated public APIs do not include XML documentation comments. -->
    <NoWarn>$(NoWarn);CS0169;1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\NativeCode\redistributable_bin\androidarm64\libsteam_api.so"
          Pack="true"
          PackagePath="runtimes/android-arm64/native/" />
    <None Include="..\NativeCode\redistributable_bin\linux64\libsteam_api.so"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/" />
    <None Include="..\NativeCode\redistributable_bin\linuxarm64\libsteam_api.so"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native/" />
    <None Include="..\NativeCode\redistributable_bin\osx\libsteam_api.dylib"
          Pack="true"
          PackagePath="runtimes/osx-x64/native/;runtimes/osx-arm64/native/" />
    <None Include="..\NativeCode\redistributable_bin\win64\steam_api64.dll"
          Pack="true"
          PackagePath="runtimes/win-x64/native/" />
  </ItemGroup>
</Project>
