--file
NativeCode\public\steam\steam_api_flat.h
--include-directory
NativeCode\public
--additional
--target=x86_64-pc-windows-msvc
--traverse
@Scripts\steam-header-files.rsp
--header-file
Header.txt
--namespace
AssetRipper.Bindings.Steamworks.Windows
--output
AssetRipper.Bindings.Steamworks\Windows
--library-path
steam_api64
--method-class-name
SteamAPI
--config
codegen=latest
file=multi
types=windows
--generate
file-scoped-namespaces
funcs-with-body=false
generated-code=none
enum-operators=false
using-statics-for-enums=false
disable-runtime-marshalling
--with-constant-folded-value
EChatSteamIDInstanceFlags.*
HSERVERQUERY_INVALID
--exclude
@Scripts\exclusions.rsp
--with-transparent-struct
@Scripts\transparent-structs.rsp
--with-attribute
@Scripts\windows-attributes.rsp
--with-using
@Scripts\usings.rsp
--with-access-specifier
*=public
